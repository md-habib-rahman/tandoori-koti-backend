generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --------------------------------------
// ADMIN USER
// --------------------------------------
model Admin {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

enum MessageStatus {
  UNREAD
  READ
  REPLIED
  ARCHIVED
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String
  message   String?       @db.Text
  status    MessageStatus @default(UNREAD)
  ipAddress String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt(sort: Desc)])
}

model RegularMenu {
  id            String   @id @default(uuid())
  categoryFi    String // e.g. "Alkuruoat"
  categoryEn    String // e.g. "Starters"
  nameFi        String // e.g. "Voi Kana"
  nameEn        String // e.g. "Butter Chicken"
  preparationFi String // Finnish ingredients/description
  preparationEn String // English ingredients/description
  price         Float
  imageUrl      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  buffetMenus BuffetMenu[]
}

model BuffetMenu {
  id        String   @id @default(uuid())
  date      DateTime @unique
  weekday   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Linked directly to dishes added from the Add New Dish page
  dishes RegularMenu[]
}
